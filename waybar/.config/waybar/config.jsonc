{
  "position": "top",
  "modules-left": [
    "hyprland/workspaces",
    "custom/play-pause"
  ], //,"hyprland/window",
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "power-profiles-daemon",
    "network",
    "pulseaudio",
    "privacy",
    "backlight",
    "battery",
    //"user",
    "custom/logout"
  ], //"power-profiles-daemon", "custom/power"
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<big>{:%Y.%m.%d}</big>\n<small>{calendar}</small>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "format": {
        "months": "<span><b>{}</b></span>",
        "days": "<span><b>{}</b></span>",
        "weeks": "<span><b>W{}</b></span>",
        "weekdays": "<span><b>{}</b></span>",
        "today": "<span color='#eb4d4b'><b>{}</b></span>"
      }
    }
  },
"battery": {
  "states": {
    "warning": 30,
    "critical": 15
  },
  "format": "{icon} {capacity}%",
  "format-warning": "{icon}  {capacity}%",
  "format-critical": "{icon}  {capacity}%",
  "format-charging": " {capacity}%",
  "format-plugged": " {capacity}%",
  "format-alt": "{icon}  {time}",
  "format-full": " {capacity}%",
  "format-icons": [
    "",
    "",
    "",
    "",
    ""
  ],
  "tooltip-format": "{time} {power}w"
},
"backlight": {
  "scroll-step":2,
  "format": "{icon} {percent}%",
  "format-icons": [
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    "",
    ""
  ],
  "tooltip-format": "{percent}% Bildschirmhelligkeit"
},
"network": {
  "format-wifi": " ",
  "format-ethernet": "󰤭 ",
  "format-linked": "{ifname} (No IP) ",
  "format-disconnected": " ",
  "tooltip-format-wifi": "{essid} ({signalStrength}%) \uf1eb \n{frequency} Ghz",
  "on-click": "kitty -e nmtui"
},
"privacy": {
	"icon-spacing": 4,
	"icon-size": 18,
	"transition-duration": 250,
	"modules": [
		{
			"type": "screenshare",
			"tooltip": true,
			"tooltip-icon-size": 24
		},
		{
			"type": "audio-in",
			"tooltip": true,
			"tooltip-icon-size": 24
		}
	],
	"ignore-monitor": true
},
"power-profiles-daemon": {
  "format": "{icon}",
  "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
  "tooltip": true,
  "format-icons": {
    "default": "",
    "performance": "",
    "balanced": " ",
    "power-saver": " "
  }
},
"pulseaudio": {
  "format": "{icon} {volume}% {format_source}",
  "format-bluetooth": "{icon} {volume}% {format_source}",
  "format-bluetooth-muted": "󰖁  {format_source}",
  "format-muted": "󰖁 {format_source}",
  "format-source": " {volume}%",
  "format-source-muted": " ",
  "format-icons": {
    "headphone": " ",
    "hands-free": "",
    "headset": "",
    "phone": "",
    "portable": "",
    "car": "",
    "default": [
      "",
      "",
      " "
    ]
  },
  "on-click": "pavucontrol"
},
"custom/logout": {
  "format": "⏻",
  "tooltip": false,
  "on-click": "wlogout"
},
"custom/play-pause": {
  "tooltip": true,
  "format": " {icon}{}",
  "return-type": "json",
  "format-icons": {
    "Paused": " ",
    "Playing": " "
  },
  "on-click-right": "playerctl next",
  "on-click": "playerctl play-pause",
  "hide-empty-text": true,
  "max-length": 40,
  "exec": "playerctl -a metadata --format '{\"text\": \"{{markup_escape(title)}} - {{artist}}\", \"tooltip\": \"{{markup_escape(title)}}, {{markup_escape(album)}}, {{artist}} \", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F"
},
"user": {
        "format": "({work_H}H↑)",
        "interval": 60,
        "icon": true,
}
}