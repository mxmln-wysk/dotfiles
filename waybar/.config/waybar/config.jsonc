{
    "position": "top",
    "modules-left": ["hyprland/workspaces", "custom/play-pause"], //,"hyprland/window",
    "modules-center": [ "clock"],
    "modules-right": ["power-profiles-daemon", "network", "pulseaudio", "backlight", "battery", "custom/logout"], //"power-profiles-daemon", "custom/power"
    "clock": {
      "format": "{:%H:%M}",
      "tooltip-format": "<big>{:%Y.%m.%d}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "battery": {
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "{icon} {capacity}%",
      "format-warning": "{icon}  {capacity}%",
      "format-critical": "{icon}  {capacity}%",
      "format-charging": " {capacity}%",
      "format-plugged": " {capacity}%",
      "format-alt": "{icon}  {time}",
      "format-full": " {capacity}%",
      "format-icons": ["", "", "", "", ""],
      "tooltip-format": "{time}"
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "tooltip-format": "{percent}% Bildschirmhelligkeit"

    },
    "network": {
      "format-wifi": " ",
      "format-ethernet": "󰤭 ",
      "format-linked": "{ifname} (No IP) ",
      "format-disconnected": " ",
      "tooltip-format-wifi": "{essid} ({signalStrength}%) \uf1eb",
      "on-click": "kitty -e nmtui"
    },
     "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": " ",
        "power-saver": " "
      }
    },
    "pulseaudio": { 
        "format": "{icon} {volume}% {format_source}",
        "format-bluetooth": "{icon} {volume}% {format_source}",
        "format-bluetooth-muted": "󰖁  {format_source}",
        "format-muted": "󰖁 {format_source}",
        "format-source": " {volume}%",
        "format-source-muted": " ",
        "format-icons": {
            "headphone": " ",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", " "]
        },
        "on-click": "pavucontrol"
    },
    "custom/logout":{
     	"format": "⏻",
     	"tooltip": false,
     	"on-click": "wlogout"
    },
    "custom/play-pause": {
      "tooltip": true,
      "format": " {icon}{}",
      "return-type": "json",
      "format-icons": {
          "Paused": " ",
          "Playing": " "
      },
      "on-click-right": "playerctl next",
      "on-click": "playerctl play-pause",
      "hide-empty-text": true,
      "max-length": 40,
      "exec": "playerctl -a metadata --format '{\"text\": \"{{markup_escape(title)}} - {{artist}}\", \"tooltip\": \"{{markup_escape(title)}}, {{markup_escape(album)}}, {{artist}} \", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F"
    }
  }
