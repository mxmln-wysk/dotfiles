{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": {
      "1": "red",
      "2": "green"
    }
  },
  "display": {
    "separator": " => ",
    "color": {
        "keys": "blue"
    },
    "key": {
      "type": "both",
      "paddingLeft": 1
    },
    "percent": {
        "type": 0      // 1=number, 2=bar, 3=both, 9=colored number
    }
  },
  "modules": [
    {
    "type": "title",
    "format": "{#green}{user-name}{#yellow}@{host-name}"
    },
    "os",
    "host",
    "kernel",
    "packages",
    "shell",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    //"uptime",
    "display",
    "cpu",
    "gpu",
    "memory",
    "locale",
    "break",
    "colors"
  ]
}